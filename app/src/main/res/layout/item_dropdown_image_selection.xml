<?xml version="1.0" encoding="utf-8"?>
<!-- 下拉菜单纯图片选项项（强化成功率计算器的主卡/副卡/VIP等）：行内只放条目图片与右侧√标记，
     首项“不选”对应 card_data_x，√仅在当前选中项显示；
     勾与图片的间距由 option_check 的 layout_marginStart 控制（想调整直接改这个值），
     颜色由 app:tint 控制（ic_check 自带的白色 tint 会被它覆盖为主题色）。
     option_image 不设 importantForAccessibility="no"，由 adapter 写入条目文本作为无障碍描述 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="?android:attr/listPreferredItemPaddingStart"
    android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
    android:paddingVertical="16dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    tools:ignore="ContentDescription">

    <ImageView
        android:id="@+id/option_image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="fitCenter" />

    <Space
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />

    <ImageView
        android:id="@+id/option_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_check"
        app:tint="?attr/colorPrimary" />
</LinearLayout>
