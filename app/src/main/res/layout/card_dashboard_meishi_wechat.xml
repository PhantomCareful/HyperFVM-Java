<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:ignore="ContentDescription">

    <androidx.cardview.widget.CardView
        android:id="@+id/dashboard_MeishiWechat_Container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginBottom="10dp"
        app:cardBackgroundColor="?attr/GeneralCardViewBackground"
        app:cardCornerRadius="20dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/dashboard_MeishiWechat_Icon"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_marginEnd="-35dp"
                android:layout_marginBottom="-35dp"
                android:layout_gravity="end|bottom"
                android:src="@drawable/ic_round_check_circle_outline"
                app:tint="?attr/TitleTextViewColorOnSurface" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="start|top"
                android:padding="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:text="@string/title_dashboard_meishi_wechat"
                    android:textSize="15sp"
                    android:textColor="?attr/SummaryTextViewColorOnGeneralCardView"/>

                <TextView
                    android:id="@+id/dashboard_MeishiWechat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/TextViewColorOnGeneralCardView"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </FrameLayout>

    </androidx.cardview.widget.CardView>

</merge>