<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    tools:ignore="MissingConstraints,contentDescription,NestedWeights,TooDeepLayout">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/oobe_introduction_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="10dp"
            android:paddingTop="110dp"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/logo_image"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_info"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:text="@string/title_oobe_introduction"
                android:textSize="35sp"
                android:textColor="?attr/colorOnSurface" />

            <com.careful.HyperFVM.utils.ForDesign.Scroll.SpringBackLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="none"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/tips_oobe_introduction_1_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:clickable="true"
                            app:cardBackgroundColor="?attr/GeneralCardViewBackground"
                            app:cardCornerRadius="20dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="16dp"
                                android:text="@string/tips_oobe_introduction_1"
                                android:textSize="15sp"
                                android:textColor="?attr/TextViewColorOnGeneralCardView" />

                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/tips_oobe_introduction_2_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:clickable="true"
                            app:cardBackgroundColor="?attr/ImportantCardViewBackground"
                            app:cardCornerRadius="20dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="16dp"
                                android:text="@string/tips_oobe_introduction_2"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="?attr/TextViewColorOnImportantCardView" />

                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            app:cardBackgroundColor="?attr/GeneralCardViewBackground"
                            app:cardCornerRadius="20dp">

                            <LinearLayout
                                android:id="@+id/oobe_introduction_using_instruction_container"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:padding="16dp"
                                android:gravity="center"
                                android:clickable="true"
                                android:background="?attr/selectableItemBackground">

                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/ic_notes"
                                    app:tint="?attr/VectorGraphicColorOnGeneralCardView" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginHorizontal="16dp"
                                    android:orientation="vertical">

                                    <!-- 左侧文字 -->
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/title_using_instruction"
                                        android:textColor="?attr/TextViewColorOnGeneralCardView"
                                        android:textSize="20sp"
                                        android:textStyle="bold"/>
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/description_using_instruction"
                                        android:textColor="?attr/SummaryTextViewColorOnGeneralCardView"
                                        android:textSize="15sp"/>

                                </LinearLayout>

                                <!-- 右侧箭头 -->
                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/ic_arrow_right"
                                    app:tint="?attr/SummaryTextViewColorOnGeneralCardView" />

                            </LinearLayout>

                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                </androidx.core.widget.NestedScrollView>
            </com.careful.HyperFVM.utils.ForDesign.Scroll.SpringBackLayout>

        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="48dp"
            app:cardBackgroundColor="?attr/DialogConfirmButtonBackground"
            app:cardCornerRadius="20dp">

            <TextView
                android:id="@+id/oobe_btn_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="11dp"
                android:gravity="center"
                android:text="@string/text_oobe_btn_next"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="?attr/DialogTextViewColorOnConfirmButton"
                android:clickable="true"
                android:background="?attr/selectableItemBackground"/>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- 占位内容区：内部组件由用户设计后二期填充 -->
    <FrameLayout
        android:id="@+id/oobe_content_slot"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ImageButton
        android:id="@+id/oobe_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="45dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/ripple_circle"
        android:src="@drawable/ic_back"
        app:tint="?attr/colorOnSurface"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>