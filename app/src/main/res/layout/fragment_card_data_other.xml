<?xml version="1.0" encoding="utf-8"?>
<com.careful.HyperFVM.utils.ForDesign.Scroll.SpringBackLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/scrollView"
        android:background="?attr/colorSurface"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false"
        tools:ignore="HardcodedText, ContentDescription, TooManyViews, MissingConstraints">

        <LinearLayout
            android:id="@+id/card_data_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:orientation="vertical"
            android:paddingTop="120dp"
            android:paddingBottom="150dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/card_data_other_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/copyright_and_molu"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginVertical="20dp"
                android:gravity="center"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>
</com.careful.HyperFVM.utils.ForDesign.Scroll.SpringBackLayout>
