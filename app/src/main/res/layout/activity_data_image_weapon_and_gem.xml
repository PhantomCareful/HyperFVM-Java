<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="TooManyViews,MissingConstraints,contentDescription,UselessParent">

    <eightbitlab.com.blurview.BlurTarget
        android:id="@+id/target"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/data_images_index_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:paddingTop="120dp"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false">

                <TextView
                    android:id="@+id/topBarBottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="25dp"
                    android:layout_marginHorizontal="16dp"
                    android:text="@string/top_bar_data_images_index_weapon_and_gem"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:visibility="visible"/>

                <androidx.cardview.widget.CardView
                    android:id="@+id/data_image_weapon_and_gem_cover_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:cardBackgroundColor="?attr/GeneralCardViewBackground"
                    app:cardCornerRadius="20dp">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:scaleType="fitStart"
                        android:src="@drawable/data_image_weapon_and_gem_cover"
                        tools:ignore="ContentDescription,TooManyViews" />

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:cardBackgroundColor="?attr/GeneralCardViewBackground"
                    app:cardCornerRadius="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/data_images_index_weapon_and_gem_0_1_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="16dp"
                            android:gravity="center"
                            android:background="?attr/selectableItemBackground">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="16dp"
                                android:orientation="vertical">

                                <!-- 左侧文字 -->
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/title_data_images_index_weapon_and_gem_0_1"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    android:textColor="?attr/TextViewColorOnGeneralCardView" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/description_data_images_index_weapon_and_gem_0_1"
                                    android:textSize="15sp"
                                    android:textColor="?attr/SummaryTextViewColorOnGeneralCardView" />

                            </LinearLayout>

                            <!-- 右侧箭头 -->
                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/ic_arrow_right"
                                app:tint="?attr/SummaryTextViewColorOnGeneralCardView" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="25dp"
                    app:cardBackgroundColor="?attr/GeneralCardViewBackground"
                    app:cardCornerRadius="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/data_images_index_weapon_and_gem_1_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="16dp"
                            android:gravity="center"
                            android:background="?attr/selectableItemBackground">

                            <!-- 左侧文字 -->
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="16dp"
                                android:text="@string/title_data_images_index_weapon_and_gem_1"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="?attr/TextViewColorOnGeneralCardView" />

                            <!-- 右侧箭头 -->
                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/ic_arrow_right"
                                app:tint="?attr/SummaryTextViewColorOnGeneralCardView" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/data_images_index_weapon_and_gem_2_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="16dp"
                            android:gravity="center"
                            android:background="?attr/selectableItemBackground">

                            <!-- 左侧文字 -->
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="16dp"
                                android:text="@string/title_data_images_index_weapon_and_gem_2"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="?attr/TextViewColorOnGeneralCardView" />

                            <!-- 右侧箭头 -->
                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/ic_arrow_right"
                                app:tint="?attr/SummaryTextViewColorOnGeneralCardView" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/data_images_index_weapon_and_gem_3_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="16dp"
                            android:gravity="center"
                            android:background="?attr/selectableItemBackground">

                            <!-- 左侧文字 -->
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="16dp"
                                android:text="@string/title_data_images_index_weapon_and_gem_3"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="?attr/TextViewColorOnGeneralCardView" />

                            <!-- 右侧箭头 -->
                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/ic_arrow_right"
                                app:tint="?attr/SummaryTextViewColorOnGeneralCardView" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/data_images_index_weapon_and_gem_4_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="16dp"
                            android:gravity="center"
                            android:background="?attr/selectableItemBackground">

                            <!-- 左侧文字 -->
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="16dp"
                                android:text="@string/title_data_images_index_weapon_and_gem_4"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="?attr/TextViewColorOnGeneralCardView" />

                            <!-- 右侧箭头 -->
                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/ic_arrow_right"
                                app:tint="?attr/SummaryTextViewColorOnGeneralCardView" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/data_images_index_weapon_and_gem_5_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="16dp"
                            android:gravity="center"
                            android:background="?attr/selectableItemBackground">

                            <!-- 左侧文字 -->
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="16dp"
                                android:text="@string/title_data_images_index_weapon_and_gem_5"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="?attr/TextViewColorOnGeneralCardView" />

                            <!-- 右侧箭头 -->
                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/ic_arrow_right"
                                app:tint="?attr/SummaryTextViewColorOnGeneralCardView" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <Space
                    android:layout_width="wrap_content"
                    android:layout_height="150dp" />

            </LinearLayout>

        </ScrollView>

    </eightbitlab.com.blurview.BlurTarget>

    <!-- 状态栏模糊遮罩层 -->
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurViewTopBar"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:clickable="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/topBar"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:text="@string/top_bar_data_images_index_weapon_and_gem"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/FloatButton_Back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="45dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/ripple_circle"
        android:src="@drawable/ic_back"
        app:tint="?attr/colorOnSurface"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>