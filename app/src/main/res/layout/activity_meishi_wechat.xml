                                android:layout_height="wrap_content"
                                android:text="@string/tips_meishi_wechat_rules_content"
                                android:textSize="15sp"
                                android:textColor="?attr/colorOnErrorContainer" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <TextView
