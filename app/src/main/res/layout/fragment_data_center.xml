<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools">

    <eightbitlab.com.blurview.BlurTarget
        android:id="@+id/targetView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:ignore="MissingConstraints">

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/DataCenter_Container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:paddingTop="120dp"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false">

                <TextView
                    android:id="@+id/topBarBottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="25dp"
                    android:layout_marginHorizontal="16dp"
                    android:text="@string/top_bar_data_center"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:visibility="visible"/>

                <include layout="@layout/card_card_data_index"/>
                <include layout="@layout/card_data_images_index"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/label_tools_made_by_xiaye"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="?attr/TitleTextViewColorOnSurface"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <include layout="@layout/card_tiramisu"/>
                    <include layout="@layout/card_molu"/>
                    <include layout="@layout/card_faa"/>
                    <include layout="@layout/card_guidao"/>
                    <include layout="@layout/card_icu"/>
                    <include layout="@layout/card_strategy"/>
                    <include layout="@layout/card_strategy_world_boss"/>
                    <include layout="@layout/card_card_calculator"/>
                    <include layout="@layout/card_gem_calculator"/>

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/label_tools_made_by_phantom_careful"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="?attr/TitleTextViewColorOnSurface"/>

                <include layout="@layout/card_today_lucky"/>
                <include layout="@layout/card_prestige_calculator"/>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="150dp" />

            </LinearLayout>

        </ScrollView>

    </eightbitlab.com.blurview.BlurTarget>

    <!-- 状态栏模糊遮罩层 -->
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurViewTopBar"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:clickable="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/topBar"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:text="@string/top_bar_data_center"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>