<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/Card_Other_Cookery"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="?attr/GeneralCardViewBackground"
    app:cardCornerRadius="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:clickable="true"
        android:background="?attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 左侧文字 -->
            <TextView
                android:id="@+id/cookery_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/TextViewColorOnGeneralCardView"
                android:textSize="20sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/cookery_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/TextViewColorOnGeneralCardView"
                android:textSize="15sp"/>

        </LinearLayout>

        <!-- 右侧卡片 -->
        <ImageView
            android:id="@+id/cookery_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/card_data_cookery_1_1"
            tools:ignore="ContentDescription" />

    </LinearLayout>

</androidx.cardview.widget.CardView>