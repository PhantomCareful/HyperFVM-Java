<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText,ButtonStyle">

    <androidx.cardview.widget.CardView
        android:id="@+id/dashboard_WorldBossDetail_Container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:visibility="gone"
        android:clickable="true"
        app:cardBackgroundColor="?attr/ImportantCardViewBackground"
        app:cardCornerRadius="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:clickable="false"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/dashboard_WorldBoss_Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="?attr/TextViewColorOnImportantCardView"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:clipChildren="false"
                android:clipToPadding="false">

                <TextView
                    android:id="@+id/dashboard_WorldBoss_Content_Status_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="?attr/SummaryTextViewColorOnImportantCardView"/>

                <TextView
                    android:id="@+id/dashboard_WorldBoss_Content_Status_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="?attr/SummaryTextViewColorOnImportantCardView"/>

                <TextView
                    android:id="@+id/dashboard_WorldBoss_Content_Status_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="?attr/SummaryTextViewColorOnImportantCardView"/>

            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/dashboard_WorldBoss_LinearProgressIndicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="10dp"
                android:indeterminate="false"
                app:trackStopIndicatorSize="10dp"
                app:trackThickness="20dp"
                app:indicatorColor="?attr/SummaryTextViewColorOnImportantCardView"
                app:trackColor="?attr/colorSurface"
                app:trackCornerRadius="25dp"/>

            <TextView
                android:id="@+id/dashboard_WorldBoss_Content_Detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="?attr/TextViewColorOnImportantCardView"/>

            <!-- 水平线段 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginVertical="10dp"
                android:alpha="0.2"
                android:background="?attr/SummaryTextViewColorOnImportantCardView"/>

            <TextView
                android:id="@+id/dashboard_WorldBoss_Content_Status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="?attr/TextViewColorOnImportantCardView"/>

            <Space
                android:layout_width="wrap_content"
                android:layout_height="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:clipChildren="false"
                android:clipToPadding="false">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="13dp">

                    <TextView
                        android:id="@+id/button_action_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="6dp"
                        android:gravity="center"
                        android:text="赛季规则"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:clickable="true"
                        android:background="?attr/selectableItemBackground"/>

                </androidx.cardview.widget.CardView>

                <Space
                    android:layout_width="10dp"
                    android:layout_height="wrap_content" />

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="13dp">

                    <TextView
                        android:id="@+id/button_action_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="6dp"
                        android:gravity="center"
                        android:text="赛季奖励"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:clickable="true"
                        android:background="?attr/selectableItemBackground"/>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</merge>