<?xml version="1.0" encoding="utf-8"?>
<!-- 下拉菜单图片+文字选项项（强化成功率计算器的四叶草）：左侧条目图片 + 中间文字
     （四叶草的加成倍率，格式 X倍）+ 右侧√标记，√仅在当前选中项显示；
     文字列带 weight=1 占满中间空间把√顶到行尾，间距由 layout_marginStart 控制，
     勾颜色由 app:tint 控制（ic_check 自带的白色 tint 会被它覆盖为主题色） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="?android:attr/listPreferredItemPaddingStart"
    android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
    android:paddingVertical="16dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/option_image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/option_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginHorizontal="16dp"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface" />

    <ImageView
        android:id="@+id/option_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_check"
        app:tint="?attr/colorPrimary" />
</LinearLayout>
