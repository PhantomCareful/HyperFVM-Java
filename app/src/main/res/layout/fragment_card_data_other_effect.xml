<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ScrollView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:ignore="HardcodedText, ContentDescription, TooManyViews, MissingConstraints">

    <LinearLayout
        android:id="@+id/card_data_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:orientation="vertical"
        android:paddingTop="120dp"
        android:paddingBottom="150dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <androidx.cardview.widget.CardView
            android:id="@+id/Card_Other"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="25dp"
            app:cardBackgroundColor="@color/card_background_color_effect"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/additional_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="[食神谱]水煮鱼：攻击力+10%"
                android:textSize="20sp"
                android:textColor="?attr/colorOnSurface"
                android:padding="16dp"
                android:clickable="true"
                android:background="?attr/selectableItemBackground"/>

        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/copyright_and_molu"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginVertical="20dp"
            android:gravity="center"/>

    </LinearLayout>

</ScrollView>