<resources>
    <!-- Default screen margins, per the Android Design guidelines. -->
    <dimen name="activity_horizontal_margin">16dp</dimen>
    <dimen name="activity_vertical_margin">16dp</dimen>
    <dimen name="fab_margin">30dp</dimen>

    <dimen name="dialog_input_padding">16dp</dimen>
    <dimen name="dialog_input_margin">16dp</dimen>
    <dimen name="dialog_input_corner_radius">20dp</dimen>

    <!-- BottomSheet 顶部圆角尺寸（单一来源）：由 bottom_sheet_rounded
         及 Widget.HyperFVMJava.BottomSheet.Modal 的 shapeAppearanceOverlay 共同引用，改一处即可全链路同步 -->
    <dimen name="bottom_sheet_top_corner_radius">40dp</dimen>

    <!-- 弹窗圆角固定值（单一来源）：46dp = 底部按钮 margin 26dp + 按钮圆角 20dp，
         使弹窗角圆心与底部按钮角圆心严格同心；由 DialogCornerRadiusUtil 读取，
         与设备屏幕物理圆角无关 -->
    <dimen name="dialog_corner_radius">51dp</dimen>
</resources>