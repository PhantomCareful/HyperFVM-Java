<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--素雅、扁平-->
    <style name="MaterialAlertDialog.NoShadow" parent="MaterialAlertDialog.Material3">
        <!-- 必须覆盖 alertDialogStyle：backgroundTint 等属性在 obtainStyledAttributes 中
             走 defStyleAttr 路径读取，其优先级高于主题直接属性，
             不覆盖会被 ThemeOverlay.Material3.MaterialAlertDialog 指向的
             MaterialAlertDialog.Material3（colorSurfaceContainerHigh）覆盖 -->
        <item name="alertDialogStyle">@style/MaterialAlertDialog.NoShadow.AlertStyle</item>
        <!-- 弹窗背景统一为 colorSurface（覆盖 Material3 默认的 colorSurfaceContainerHigh） -->
        <item name="backgroundTint">?attr/colorSurface</item>

        <!-- 关闭阴影裁剪 -->
        <item name="android:clipChildren">false</item>
        <item name="android:clipToPadding">false</item>
    </style>

    <!-- 弹窗实际读取的默认样式（经 alertDialogStyle 的 defStyleAttr 路径生效） -->
    <style name="MaterialAlertDialog.NoShadow.AlertStyle" parent="MaterialAlertDialog.Material3">
        <item name="backgroundTint">?attr/colorSurface</item>
    </style>

    <!-- ============ HC 弹窗两端动画复刻（窗口级，由 WMS 播放） ============
         手机：从屏幕下方飞入/飞出（对标 fan PhoneDialogAnim）
         PAD：屏幕中心淡入+微缩放/淡出（对标 fan PadDialogAnim）
         经 DialogCornerRadiusUtil.apply 在 show 前按 DeviceTypeUtil 分支设置 -->
    <style name="DialogWindowAnim.Phone" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/dialog_slide_in_bottom</item>
        <item name="android:windowExitAnimation">@anim/dialog_slide_out_bottom</item>
    </style>

    <style name="DialogWindowAnim.Pad" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/dialog_fade_in_center</item>
        <item name="android:windowExitAnimation">@anim/dialog_fade_out_center</item>
    </style>
</resources>