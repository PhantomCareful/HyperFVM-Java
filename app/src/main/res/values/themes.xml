<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.HyperFVMJava" parent="Theme.Material3.DynamicColors.DayNight">
        <!--SplashScreen背景颜色-->
        <item name="android:windowSplashScreenBackground">@color/splash_color</item>
        <!--SplashScreen图标-->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>

        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <!--BottomSheetDialog内部背景层透明化，使圆角/颜色/透明度由bottom_sheet_rounded控制-->
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.HyperFVMJava.BottomSheetDialog</item>

        <!--Button的默认样式-->
        <item name="materialButtonStyle">@style/Button.NoShadow</item>

        <!--CardView的默认样式-->
        <item name="cardViewStyle">@style/CardView.NoShadow</item>

        <!--MaterialSwitch默认样式：去掉未开启时的外圈描边-->
        <item name="materialSwitchStyle">@style/Switch.NoStroke</item>

        <!--标题文字颜色-->
        <item name="TitleTextViewColorOnSurface">?attr/colorPrimary</item>

        <!--一般CardView-->
        <!--卡片颜色-->
        <item name="GeneralCardViewBackground">?attr/colorSurfaceContainer</item>
        <!--文字颜色-->
        <item name="TextViewColorOnGeneralCardView">?attr/colorOnSurface</item>
        <!--次要文字颜色-->
        <item name="SummaryTextViewColorOnGeneralCardView">?attr/colorOnSurfaceVariant</item>
        <!--矢量图颜色-->
        <item name="VectorGraphicColorOnGeneralCardView">?attr/colorOnSurface</item>

        <!--重要CardView-->
        <!--卡片颜色-->
        <item name="ImportantCardViewBackground">?attr/colorSecondaryContainer</item>
        <!--文字颜色-->
        <item name="TextViewColorOnImportantCardView">?attr/colorOnSurface</item>
        <!--次要文字颜色-->
        <item name="SummaryTextViewColorOnImportantCardView">?attr/colorOnSecondaryContainer</item>
        <!--矢量图颜色-->
        <item name="VectorGraphicColorOnImportantCardView">?attr/colorOnSurface</item>

        <!--状态卡片：这些卡片右下角都会放一个大图标-->
        <!--卡片颜色-->
        <item name="StatusCardViewBackground">?attr/colorSecondaryContainer</item>
        <!--文字颜色-->
        <item name="TextViewColorOnStatusCardView">?attr/colorOnSurface</item>
        <!--次要文字颜色-->
        <item name="SummaryTextViewColorOnStatusCardView">?attr/colorOnSecondaryContainer</item>
        <!--矢量图颜色-->
        <item name="VectorGraphicColorOnStatusCardView">?attr/colorPrimary</item>
        <!--矢量图透明度：Miuix主题1.0f（完全不透明），其余主题0.8f-->
        <item name="VectorGraphicAlphaOnStatusCardView">0.8</item>

        <!--开关配色-->
        <item name="SwitchUncheckedBackgroundColor">?attr/colorSurfaceDim</item>
        <item name="SwitchUncheckedCircleColor">?attr/colorOutline</item>
        <item name="SwitchCheckedBackgroundColor">?attr/colorPrimary</item>
        <item name="SwitchCheckedCircleColor">?attr/colorOnPrimary</item>
        <item name="SwitchUncheckedTouchColor">?attr/colorOutline</item>
        <item name="SwitchCheckedTouchColor">?attr/colorOnPrimary</item>
        <item name="SwitchDisabledUncheckedBackgroundColor">?attr/colorSurfaceContainerHighest</item>
        <item name="SwitchDisabledUncheckedCircleColor">?attr/colorSurfaceDim</item>
        <item name="SwitchDisabledCheckedBackgroundColor">?attr/colorSecondaryContainer</item>
        <item name="SwitchDisabledCheckedCircleColor">?attr/colorSurfaceBright</item>

        <!--弹窗-->
        <!--背景颜色-->
        <item name="DialogBackground">?attr/colorSurface</item>
        <!--弹窗确认按钮背景颜色-->
        <item name="DialogConfirmButtonBackground">?attr/colorPrimary</item>
        <!--弹窗确认按钮文字颜色-->
        <item name="DialogTextViewColorOnConfirmButton">?attr/colorOnPrimary</item>
        <!--弹窗取消按钮背景颜色-->
        <item name="DialogCancelButtonBackground">?attr/colorSurfaceContainer</item>
        <!--弹窗取消按钮文字颜色-->
        <item name="DialogTextViewColorOnCancelButton">?attr/colorOnSurface</item>
        <!--弹窗中的一般卡片颜色-->
        <item name="DialogGeneralCardViewBackground">?attr/colorSurfaceContainer</item>
        <!--弹窗中矢量图颜色-->
        <item name="DialogVectorGraphicColorOnGeneralCardView">?attr/colorOnPrimaryContainer</item>
    </style>

    <!-- 数据图内置查看器：固定黑底全屏（图片查看场景不随主题/深浅色变化），打开瞬间不闪白 -->
    <style name="Theme.HyperFVMJava.DataImageViewer" parent="Base.Theme.HyperFVMJava">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- 动态取色/全部主题的公共属性已上移至 Base.Theme.HyperFVMJava，本样式仅作兼容保留 -->
    <style name="Base.Theme.HyperFVMJava.NoShadow" parent="Base.Theme.HyperFVMJava" />

    <!-- 链接接入中转页：全透明不抢焦点，确认弹窗直接浮在来源应用（如微信）画面上，
         确认/取消后立即finish回到来源应用。不能调用ThemeManager.applyTheme（setTheme会覆盖透明属性） -->
    <style name="Theme.HyperFVMJava.LinkReceiver" parent="Base.Theme.HyperFVMJava.NoShadow">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>

</resources>