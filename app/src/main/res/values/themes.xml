<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.HyperFVMJava" parent="Theme.Material3.DynamicColors.DayNight">
        <!--SplashScreen背景颜色-->
        <item name="android:windowSplashScreenBackground">@color/splash_color</item>
        <!--SplashScreen图标-->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>

        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <!--BottomSheetDialog内部背景层透明化，使圆角/颜色/透明度由bottom_sheet_rounded控制-->
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.HyperFVMJava.BottomSheetDialog</item>

        <!--fan Miuix BottomSheet（bottomsheet aar）布局依赖的主题 attr：
            drag handle 的宽高/前景图、弹层背景/圆角/behavior 参数全靠这两个 style 提供，
            主题链未注入时 ?attr 解析为空会直接崩 "You must supply a layout_width attribute"。
            bottomSheetStyle 指向 Custom（背景覆盖为 colorSurface）：fan 默认 miuix surface 色
            与内容布局 colorSurface 断层，顶部把手区/底部导航条预留区观感不匹配 -->
        <item name="bottomSheetDragHandleStyle">@style/Widget.Miuix.BottomSheet.DragHandle.DayNight</item>
        <item name="bottomSheetStyle">@style/Widget.Miuix.BottomSheet.Modal.Custom</item>

        <!--fan 深浅色判定 + Miuix Checkbox 映射链（fan 的 Theme 主题系列未引入，
            Widget.CompoundButton.CheckBox 的 button/textColor 全部悬空会退化成原生样式）：
            isLightTheme 供 BottomSheetView/DragHandleView 判深浅选 drawable；
            listChoiceIndicatorMultiple→checkBoxDrawable 提供 off_to_on/on_to_off 过渡动画 drawable；
            light/dark 经 values 与 values-night 的别名资源自动切换（见 miuix_pilot.xml） -->
        <item name="isLightTheme">@bool/miuix_is_light_theme</item>
        <item name="android:isLightTheme">@bool/miuix_is_light_theme</item>
        <item name="android:listChoiceIndicatorMultiple">?checkBoxDrawable</item>
        <item name="checkBoxDrawable">@drawable/miuix_pilot_checkbox</item>
        <item name="checkableButtonTextColorSingle">@color/miuix_pilot_checkable_text</item>
        <!-- CheckWidgetDrawable 代码绘制的圈/勾参数（fan 在 Theme.AppCompat.Light/Dark 注入，
             Light 版已随计划删除；缺失时 safeGetColor/safeGetInt 兜底为透明或黑） -->
        <!-- strokeColor 置透明：fan 未选中圈底层会额外画 2px 白描边（原值 #ffffff、
             Paint 默认 alpha 恒 255，浅色页可见白圈），透明色使构造侧 hasStroke=false
             直接跳过描边绘制；未选中淡色底圈（disableBackgroundColor + normalAlpha）保留 -->
        <item name="checkWidgetStrokeColor">@android:color/transparent</item>
        <item name="checkWidgetStrokeNormalAlpha">@integer/miuix_pilot_cb_stroke_normal_alpha</item>
        <item name="checkWidgetStrokeDisableAlpha">@integer/miuix_pilot_cb_stroke_disable_alpha</item>
        <item name="checkWidgetBackgroundNormalAlpha">@integer/miuix_pilot_cb_background_normal_alpha</item>
        <item name="checkWidgetBackgroundDisableAlpha">@integer/miuix_pilot_cb_background_disable_alpha</item>
        <item name="checkWidgetOnAlphaDrawableBackgroundColor">@color/miuix_pilot_cb_background_disabled</item>
        <item name="checkWidgetDisableDrawableBackgroundColor">@color/miuix_pilot_cb_background_disabled</item>
        <item name="checkBoxOnDrawableForegroundColor">?attr/colorOnPrimary</item>
        <item name="checkBoxOnDrawableBackgroundColor">?attr/colorPrimary</item>
        <!-- 按压缩放动画（CheckWidgetDrawableAnims 的 Spring scale）：fan style 经
             ?checkBoxDrawableTouchAnimEnable 引用，主题缺失时解析为空则按压无缩小反馈 -->
        <item name="checkBoxDrawableTouchAnimEnable">true</item>

        <!--Button的默认样式-->
        <item name="materialButtonStyle">@style/Button.NoShadow</item>

        <!--CardView的默认样式-->
        <item name="cardViewStyle">@style/CardView.NoShadow</item>

        <!--MaterialSwitch默认样式：去掉未开启时的外圈描边-->
        <item name="materialSwitchStyle">@style/Switch.NoStroke</item>

        <!--标题文字颜色-->
        <item name="TitleTextViewColorOnSurface">?attr/colorPrimary</item>

        <!--一般CardView-->
        <!--卡片颜色-->
        <item name="GeneralCardViewBackground">?attr/colorSurfaceContainer</item>
        <!--文字颜色-->
        <item name="TextViewColorOnGeneralCardView">?attr/colorOnSurface</item>
        <!--次要文字颜色-->
        <item name="SummaryTextViewColorOnGeneralCardView">?attr/colorOnSurfaceVariant</item>
        <!--矢量图颜色-->
        <item name="VectorGraphicColorOnGeneralCardView">?attr/colorOnSurface</item>

        <!--重要CardView-->
        <!--卡片颜色-->
        <item name="ImportantCardViewBackground">?attr/colorSecondaryContainer</item>
        <!--文字颜色-->
        <item name="TextViewColorOnImportantCardView">?attr/colorOnSurface</item>
        <!--次要文字颜色-->
        <item name="SummaryTextViewColorOnImportantCardView">?attr/colorOnSecondaryContainer</item>
        <!--矢量图颜色-->
        <item name="VectorGraphicColorOnImportantCardView">?attr/colorOnSurface</item>

        <!--状态卡片：这些卡片右下角都会放一个大图标-->
        <!--卡片颜色-->
        <item name="StatusCardViewBackground">?attr/colorSecondaryContainer</item>
        <!--文字颜色-->
        <item name="TextViewColorOnStatusCardView">?attr/colorOnSurface</item>
        <!--次要文字颜色-->
        <item name="SummaryTextViewColorOnStatusCardView">?attr/colorOnSecondaryContainer</item>
        <!--矢量图颜色-->
        <item name="VectorGraphicColorOnStatusCardView">?attr/colorPrimary</item>
        <!--矢量图透明度：Miuix主题1.0f（完全不透明），其余主题0.8f-->
        <item name="VectorGraphicAlphaOnStatusCardView">0.8</item>

        <!--开关配色-->
        <item name="SwitchUncheckedBackgroundColor">?attr/colorSurfaceDim</item>
        <item name="SwitchUncheckedCircleColor">?attr/colorOutline</item>
        <item name="SwitchCheckedBackgroundColor">?attr/colorPrimary</item>
        <item name="SwitchCheckedCircleColor">?attr/colorOnPrimary</item>
        <item name="SwitchUncheckedTouchColor">?attr/colorOutline</item>
        <item name="SwitchCheckedTouchColor">?attr/colorOnPrimary</item>
        <item name="SwitchDisabledUncheckedBackgroundColor">?attr/colorSurfaceContainerHighest</item>
        <item name="SwitchDisabledUncheckedCircleColor">?attr/colorSurfaceDim</item>
        <item name="SwitchDisabledCheckedBackgroundColor">?attr/colorSecondaryContainer</item>
        <item name="SwitchDisabledCheckedCircleColor">?attr/colorSurfaceBright</item>

        <!--弹窗-->
        <!--背景颜色-->
        <item name="DialogBackground">?attr/colorSurface</item>
        <!--弹窗确认按钮背景颜色-->
        <item name="DialogConfirmButtonBackground">?attr/colorPrimary</item>
        <!--弹窗确认按钮文字颜色-->
        <item name="DialogTextViewColorOnConfirmButton">?attr/colorOnPrimary</item>
        <!--弹窗取消按钮背景颜色-->
        <item name="DialogCancelButtonBackground">?attr/colorSurfaceContainer</item>
        <!--弹窗取消按钮文字颜色-->
        <item name="DialogTextViewColorOnCancelButton">?attr/colorOnSurface</item>
        <!--弹窗中的一般卡片颜色-->
        <item name="DialogGeneralCardViewBackground">?attr/colorSurfaceContainer</item>
        <!--弹窗中矢量图颜色-->
        <item name="DialogVectorGraphicColorOnGeneralCardView">?attr/colorOnPrimaryContainer</item>
    </style>

    <!-- 数据图内置查看器：固定黑底全屏（图片查看场景不随主题/深浅色变化），打开瞬间不闪白 -->
    <style name="Theme.HyperFVMJava.DataImageViewer" parent="Base.Theme.HyperFVMJava">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- 动态取色/全部主题的公共属性已上移至 Base.Theme.HyperFVMJava，本样式仅作兼容保留 -->
    <style name="Base.Theme.HyperFVMJava.NoShadow" parent="Base.Theme.HyperFVMJava" />

    <!-- 链接接入中转页：全透明不抢焦点，确认弹窗直接浮在来源应用（如微信）画面上，
         确认/取消后立即finish回到来源应用。不能调用ThemeManager.applyTheme（setTheme会覆盖透明属性） -->
    <style name="Theme.HyperFVMJava.LinkReceiver" parent="Base.Theme.HyperFVMJava.NoShadow">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>

    <!-- fan Miuix 弹层本体背景对齐项目 colorSurface（parent 继承 fan 的圆角/模糊/behavior 参数）。
         miuixPaddingBottomSystemWindowInsets=false：BottomSheetView 标签的 style=?attr/bottomSheetStyle
         会进入 BottomSheetBehavior 的 obtainStyledAttributes(attributeSet,...)，覆盖其默认 true，
         去掉底部导航栏高度的 padding（Behavior L2283-2285），使弹层内容延伸到导航栏后方（Edge-to-Edge）。
         配合 dimens.xml 的 miuix_bottom_sheet_extra_height=0dp 消除底部 100dp 额外占位 -->
    <style name="Widget.Miuix.BottomSheet.Modal.Custom" parent="Widget.Miuix.BottomSheet.Modal.DayNight">
        <item name="android:background">?attr/colorSurface</item>
        <item name="miuixPaddingBottomSystemWindowInsets">false</item>
    </style>

</resources>