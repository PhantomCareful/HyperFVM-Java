<resources>
    <!-- fan 链路圆形勾选框（与 Miuix 弹层试点同配方）：
         parent 走 fan 的 Widget.CompoundButton.CheckBox，勾选 drawable 不用 buttonCompat，
         而是经 themes.xml 全局注入链生效：
         android:listChoiceIndicatorMultiple=?checkBoxDrawable -> @drawable/miuix_pilot_checkbox
         （checkBoxDrawableTouchAnimEnable=true，附带按压缩放与勾选过渡动画，深浅色随 fan 资源切换）；
         不再用 M3 parent 也因 m3_checkbox_button_tint 会以 SRC_IN 把自定义视觉染成单色；
         显式 wrap_content 压 fan 基础样式的 0dp（该样式按 match_parent 场景设计）；
         buttonTint 固定为 colorOnPrimary 与试点视觉一致；
         background 置 @null 去掉按下圆波纹（原 M3 样式 m3_selection_control_ripple 的
         dispatchSetPressed 传播隐患，点击行容器时会误触发 child 圆波）；
         计算器页勾选框无标签文字，textColor 仅备后续加文案时主题自适应 -->
    <style name="Checkbox.Round" parent="Widget.CompoundButton.CheckBox">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@null</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="buttonTint">?attr/colorOnPrimary</item>
    </style>
</resources>
