<resources>
    <style name="Miuix" parent="Theme.Material3.Light.NoActionBar">
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.HyperFVMJava.BottomSheetDialog</item>
        <!--Button的默认样式-->
        <item name="materialButtonStyle">@style/Button.NoShadow</item>

        <!--CardView的默认样式-->
        <item name="cardViewStyle">@style/CardView.NoShadow</item>

        <!--MaterialSwitch默认样式：去掉未开启时的外圈描边-->
        <item name="materialSwitchStyle">@style/Switch.NoStroke</item>

        <!--标题文字颜色-->
        <item name="TitleTextViewColorOnSurface">@color/miuix_on_background_variant</item>

        <!--一般CardView-->
        <!--卡片颜色-->
        <item name="GeneralCardViewBackground">@color/miuix_surface_container</item>
        <!--文字颜色-->
        <item name="TextViewColorOnGeneralCardView">@color/miuix_on_surface</item>
        <!--次要文字颜色-->
        <item name="SummaryTextViewColorOnGeneralCardView">@color/miuix_on_surface_variant_summary</item>
        <!--矢量图颜色-->
        <item name="VectorGraphicColorOnGeneralCardView">@color/miuix_on_surface</item>

        <!--重要CardView-->
        <!--卡片颜色-->
        <item name="ImportantCardViewBackground">?attr/colorTertiaryContainer</item>
        <!--文字颜色-->
        <item name="TextViewColorOnImportantCardView">?attr/colorOnTertiaryContainer</item>
        <!--次要文字颜色-->
        <item name="SummaryTextViewColorOnImportantCardView">?attr/colorOnTertiaryContainer</item>
        <!--矢量图颜色-->
        <item name="VectorGraphicColorOnImportantCardView">?attr/colorOnTertiaryContainer</item>

        <!--状态卡片：这些卡片右下角都会放一个大图标-->
        <!--卡片颜色-->
        <item name="StatusCardViewBackground">@color/miuix_status_cardview_background</item>
        <!--文字颜色-->
        <item name="TextViewColorOnStatusCardView">@color/miuix_textview_color_on_status_cardview</item>
        <!--次要文字颜色-->
        <item name="SummaryTextViewColorOnStatusCardView">@color/miuix_summary_textview_color_on_status_cardview</item>
        <!--矢量图颜色-->
        <item name="VectorGraphicColorOnStatusCardView">@color/miuix_vector_graphic_color_on_status_cardview</item>
        <!--矢量图透明度：Miuix主题1.0f（完全不透明），其余主题0.8f-->
        <item name="VectorGraphicAlphaOnStatusCardView">1.0</item>

        <!--开关配色-->
        <item name="SwitchUncheckedBackgroundColor">?attr/colorSecondary</item>
        <item name="SwitchUncheckedCircleColor">?attr/colorOnPrimary</item>
        <item name="SwitchCheckedBackgroundColor">?attr/colorPrimary</item>
        <item name="SwitchCheckedCircleColor">?attr/colorOnPrimary</item>
        <item name="SwitchUncheckedTouchColor">?attr/colorOnSecondary</item>
        <item name="SwitchCheckedTouchColor">?attr/colorOnSecondary</item>
        <item name="SwitchDisabledUncheckedBackgroundColor">@color/miuix_secondary_variant</item>
        <item name="SwitchDisabledUncheckedCircleColor">@color/miuix_disabled_on_secondary</item>
        <item name="SwitchDisabledCheckedBackgroundColor">@color/miuix_disabled_primary_button</item>
        <item name="SwitchDisabledCheckedCircleColor">@color/miuix_disabled_on_primary</item>

        <!--弹窗-->
        <!--背景颜色-->
        <item name="DialogBackground">@color/miuix_background</item>
        <!--弹窗确认按钮背景颜色-->
        <item name="DialogConfirmButtonBackground">?attr/colorPrimary</item>
        <!--弹窗确认按钮文字颜色-->
        <item name="DialogTextViewColorOnConfirmButton">?attr/colorOnPrimary</item>
        <!--弹窗取消按钮背景颜色-->
        <item name="DialogCancelButtonBackground">@color/miuix_secondary_variant</item>
        <!--弹窗取消按钮文字颜色-->
        <item name="DialogTextViewColorOnCancelButton">@color/miuix_on_secondary_variant</item>
        <!--弹窗中的一般卡片颜色-->
        <item name="DialogGeneralCardViewBackground">@color/miuix_secondary_variant</item>
        <!--弹窗中矢量图颜色-->
        <item name="DialogVectorGraphicColorOnGeneralCardView">?attr/colorOnBackground</item>

        <item name="colorPrimary">@color/miuix_primary</item>
        <item name="colorOnPrimary">@color/miuix_on_primary</item>
        <item name="colorPrimaryContainer">@color/miuix_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/miuix_on_primary_container</item>
        <item name="colorSecondary">@color/miuix_secondary</item>
        <item name="colorOnSecondary">@color/miuix_on_secondary</item>
        <item name="colorSecondaryContainer">@color/miuix_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/miuix_on_secondary_container</item>
        <item name="colorTertiary">@color/md_blue_kongquelan_tertiary</item>
        <item name="colorOnTertiary">@color/md_blue_kongquelan_onTertiary</item>
        <item name="colorTertiaryContainer">@color/miuix_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/miuix_on_tertiary_container</item>
        <item name="colorError">@color/miuix_error</item>
        <item name="colorOnError">@color/miuix_on_error</item>
        <item name="colorErrorContainer">@color/miuix_error_container</item>
        <item name="colorOnErrorContainer">@color/miuix_on_error_container</item>
        <!-- 窗口背景与页面底色保持一致：模糊快照以 windowBackground 打底，
             若用默认的 colorBackground（深色 #242424）会与页面 colorSurface（深色 #000000）断层，
             导致模糊区明显偏白 -->
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:colorBackground">@color/miuix_background</item>
        <item name="colorOnBackground">@color/miuix_on_background</item>
        <item name="colorSurface">@color/miuix_surface</item>
        <item name="colorOnSurface">@color/miuix_on_surface</item>
        <item name="colorSurfaceVariant">@color/miuix_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/miuix_on_surface_variant_summary</item>
        <item name="colorOutline">@color/miuix_outline</item>
        <item name="colorOutlineVariant">@color/miuix_outline_variant</item>
        <item name="colorSurfaceInverse">@color/md_blue_kongquelan_inverseSurface</item>
        <item name="colorOnSurfaceInverse">@color/md_blue_kongquelan_inverseOnSurface</item>
        <item name="colorPrimaryInverse">@color/md_blue_kongquelan_inversePrimary</item>
        <item name="colorPrimaryFixed">@color/md_blue_kongquelan_primaryFixed</item>
        <item name="colorOnPrimaryFixed">@color/md_blue_kongquelan_onPrimaryFixed</item>
        <item name="colorPrimaryFixedDim">@color/md_blue_kongquelan_primaryFixedDim</item>
        <item name="colorOnPrimaryFixedVariant">@color/md_blue_kongquelan_onPrimaryFixedVariant</item>
        <item name="colorSecondaryFixed">@color/md_blue_kongquelan_secondaryFixed</item>
        <item name="colorOnSecondaryFixed">@color/md_blue_kongquelan_onSecondaryFixed</item>
        <item name="colorSecondaryFixedDim">@color/md_blue_kongquelan_secondaryFixedDim</item>
        <item name="colorOnSecondaryFixedVariant">@color/md_blue_kongquelan_onSecondaryFixedVariant</item>
        <item name="colorTertiaryFixed">@color/md_blue_kongquelan_tertiaryFixed</item>
        <item name="colorOnTertiaryFixed">@color/md_blue_kongquelan_onTertiaryFixed</item>
        <item name="colorTertiaryFixedDim">@color/md_blue_kongquelan_tertiaryFixedDim</item>
        <item name="colorOnTertiaryFixedVariant">@color/md_blue_kongquelan_onTertiaryFixedVariant</item>
        <item name="colorSurfaceDim">@color/md_blue_kongquelan_surfaceDim</item>
        <item name="colorSurfaceBright">@color/md_blue_kongquelan_surfaceBright</item>
        <item name="colorSurfaceContainerLowest">@color/md_blue_kongquelan_surfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/md_blue_kongquelan_surfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/miuix_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/miuix_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/miuix_surface_container_highest</item>
    </style>
</resources>
