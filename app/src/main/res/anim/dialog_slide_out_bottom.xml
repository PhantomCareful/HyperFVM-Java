<?xml version="1.0" encoding="utf-8"?>
<!-- HC 弹窗动画复刻·手机端退出：面板向屏幕下方飞出。
     对标 fan PhoneDialogAnim.dismissPanel：translationY → height；原版 200ms+
     DecelerateInterpolator(1.5F)，实测起手瞬时速度最大、与进场对比生硬，按手感调至
     350ms（与进场对称）、插值器与进场同步 fast_out_slow_in S 曲线（0 速度平滑起收）。
     插值器必须是框架内置项：动画由 WMS 进程加载，自定义插值器连字符标签
     <decelerate-interpolator> 不在 AOSP camelCase 名单，会抛 Unknown interpolator name
     → 退场动画加载失败窗口直接移除“消失”；framework 资源则必然可加载 -->
<translate xmlns:android="http://schemas.android.com/apk/res/android"
    android:fromYDelta="0"
    android:toYDelta="100%p"
    android:duration="350"
    android:interpolator="@android:interpolator/fast_out_slow_in" />
