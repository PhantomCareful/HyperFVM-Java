<?xml version="1.0" encoding="utf-8"?>
<!-- HC 弹窗动画复刻·PAD 端进入：屏幕中心淡入 + 微缩放。
     对标 fan PadDialogAnim（Folme 弹簧主路径原参数）：
     scale max(0.8, 1-60/max(w,h))→1、alpha 0→1、300ms；
     本文件 scale 起点 0.93 = fan 动态公式对典型 PAD 大弹窗（高 ~860px）的折算值——
     fan 对大面板只缩 ~6%，固定 0.8 是 3 倍变化量、150ms 内观感生硬；
     时长 300ms 为原版值（调至 150ms 后无论何种曲线都“抽一下”出现，曲线差异也无法感知）；
     插值器：HC 实际走的是 Folme 物理弹簧分支（EaseManager style -2, damping=0.8,
     response=0.3，0 速度平滑起步/柔和收住、几乎无过冲），非 Decelerate——后者只是
     AndroidUIThread 调试分支。框架近似用 fast_out_slow_in（S 曲线，0 速度起收，
     弹簧感最接近）；自定义插值器连字符标签会在 WMS 进程解析失败；
     全屏窗口绕中心缩放 = 面板（gravity 居中）原地缩放，与 fan 面板级动画视觉等效 -->
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <scale
        android:fromXScale="0.85"
        android:fromYScale="0.85"
        android:toXScale="1.0"
        android:toYScale="1.0"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="200"
        android:interpolator="@android:interpolator/fast_out_slow_in" />
    <alpha
        android:fromAlpha="0.0"
        android:toAlpha="1.0"
        android:duration="200"
        android:interpolator="@android:interpolator/fast_out_slow_in" />
</set>
