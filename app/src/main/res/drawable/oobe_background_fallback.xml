<?xml version="1.0" encoding="utf-8"?>
<!-- OOBE 欢迎页静态兜底背景（SDK<33 无 RuntimeShader 时经 background_image 显示）。
     配色取 glow 三色 uniform 的低饱和暗色近似（深紫蓝→黑），观感降级但不突兀 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:centerColor="#FF2A2450"
        android:endColor="#FF120E22"
        android:startColor="#FF0A0814"
        android:type="radial"
        android:gradientRadius="80%p"
        android:centerX="0.5"
        android:centerY="0.4" />
</shape>
