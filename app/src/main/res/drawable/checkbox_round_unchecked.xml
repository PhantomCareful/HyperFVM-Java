<?xml version="1.0" encoding="utf-8"?>
<!-- 未选中态：描边空心圆（描边色 colorOnSurfaceVariant 随主题/深浅色适配） -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- 半径引用单源 dimen，改一处即可全局调整圆形半径 -->
    <corners android:radius="@dimen/checkbox_corner_radius" />
    <solid android:color="?attr/SwitchUncheckedBackgroundColor" />
    <!-- 提供 intrinsic size，CompoundButton wrap_content 测量依据 -->
    <size
        android:width="@dimen/checkbox_box_size"
        android:height="@dimen/checkbox_box_size" />
</shape>
