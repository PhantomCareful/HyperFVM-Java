<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MissingConstraints,TooManyViews,ContentDescription">

    <eightbitlab.com.blurview.BlurTarget
        android:id="@+id/target"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 原巨型静态 ScrollView 目录改为 RecyclerView 虚拟化列表：
             47 个分节标题 + 367 张卡片均按需创建，只有可见行才会被 inflate 与解码，
             大幅降低进入延迟与内存占用。
             注：原平板双列静态布局改为单列列表（其余装饰层不变） -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/RecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="300dp"
            android:paddingBottom="50dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:scrollbars="none"
            tools:ignore="MissingConstraints" />

        <LinearLayout
            android:id="@+id/card_data_index_background_images_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="120dp"
            android:layout_marginHorizontal="20dp">

            <ImageView
                android:id="@+id/card_data_index_background_image_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/card_data_index_3_1_1_2_big"
                tools:ignore="ContentDescription" />

            <ImageView
                android:id="@+id/card_data_index_background_image_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/card_data_index_4_2_7_2_big"
                tools:ignore="ContentDescription" />

            <ImageView
                android:id="@+id/card_data_index_background_image_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/card_data_index_9_3_5_2_big"
                tools:ignore="ContentDescription" />

            <ImageView
                android:id="@+id/card_data_index_background_image_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/card_data_index_4_2_4_2_big"
                tools:ignore="ContentDescription" />

            <ImageView
                android:id="@+id/card_data_index_background_image_5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/card_data_index_8_1_4_2_big"
                tools:ignore="ContentDescription" />

            <ImageView
                android:id="@+id/card_data_index_background_image_6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/card_data_index_4_2_10_2_big"
                tools:ignore="ContentDescription" />

            <ImageView
                android:id="@+id/card_data_index_background_image_7"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/card_data_index_16_1_9_3_big"
                tools:ignore="ContentDescription" />

        </LinearLayout>

    </eightbitlab.com.blurview.BlurTarget>

    <!-- 状态栏模糊遮罩层 -->
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurViewTopBar"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:clickable="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/topBar"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:text="@string/top_bar_card_data_index"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/FloatButton_Back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="45dp"
        android:layout_marginStart="20dp"
        android:background="@drawable/ripple_circle"
        android:src="@drawable/ic_back"
        app:tint="?attr/colorOnSurface"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent" />

    <ImageButton
        android:id="@+id/FloatButton_Index"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="45dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/ripple_circle"
        android:src="@drawable/ic_index"
        app:tint="?attr/colorOnSurface"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/FloatButton_Search" />

    <ImageButton
        android:id="@+id/FloatButton_Search"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="45dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/ripple_circle"
        android:src="@drawable/ic_search"
        app:tint="?attr/colorOnSurface"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
