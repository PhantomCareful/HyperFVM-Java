<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 选中状态（TabLayout 的 Tab 使用 state_selected，与 BottomNavigationView 的 state_checked 不同） -->
    <item android:color="?attr/colorOnSurface" android:state_selected="true"/>
    <!-- 未选中状态 -->
    <item android:color="?attr/colorOnSurface" android:alpha="0.5"/>
</selector>
