<?xml version="1.0" encoding="utf-8"?>
<!-- 输入框描边状态色：聚焦时 colorPrimary，未聚焦回落 colorSecondaryContainer（与填充同色，配合 boxStrokeWidth=0dp 视觉上无描边） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="?attr/colorPrimary" />
    <item android:color="?attr/colorSecondaryContainer" />
</selector>
